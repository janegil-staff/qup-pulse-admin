{
  "name": "qup-pulse-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:comments": "node scripts/seed-comments.js",
    "seed:comments:remove": "node scripts/unseed-comments.js",
    "seed:assets": "node scripts/uploadSeedAssets.js",
    "seed:assets:remove": "node scripts/removeSeedAssets.js --confirm",
    "seed:demo": "node scripts/seedDemoData.js",
    "seed:demo:remove": "node scripts/removeDemoData.js",
    "seed:down": "node scripts/removeSeedAssets.js --confirm  && node scripts/unseed-comments.cjs && node scripts/removeDemoData.js",
    "seed:up": "node scripts/uploadSeedAssets.js && node scripts/seedDemoData.js && node scripts/seed-comments.cjs",
    "seed:all": "npm run seed:assets && npm run seed:demo",
    "seed:reset": "npm run seed:down && npm run seed:up"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "autoprefixer": "^10.5.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2"
  }
}
